{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/espace-client/",
      "destination": "https://brh-coaching-app.vercel.app",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "https://brh-coaching-app.vercel.app",
      "permanent": false
    },
    {
      "source": "/domicile/",
      "destination": "/coaching-a-domicile/",
      "permanent": true
    },
    {
      "source": "/distance/",
      "destination": "/suivi-a-distance/",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/questions-frequentes/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
